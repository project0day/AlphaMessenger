<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlphaMessenger" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryDark">@color/midnight_purple</item>
        <item name="colorAccent">@color/teal_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Video player: its first full-screen frame is never seen, it opens as the floating window. -->
    <style name="Theme.AlphaMessenger.Player">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.AlphaMessenger.Crop" parent="Theme.AppCompat.Light.DarkActionBar" />

    <style name="Theme.AlphaMessenger.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.AlphaMessenger</item>
    </style>
</resources>

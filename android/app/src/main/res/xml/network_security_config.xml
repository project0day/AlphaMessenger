<?xml version="1.0" encoding="utf-8"?>
<!-- No plain-text traffic anywhere. Tor and the local net switch are SOCKS,
     which this config does not govern. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
